# TMDB API Key - get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Your self-hosted ntfy server URL (e.g. https://ntfy.yourdomain.com)
NTFY_URL=https://ntfy.yourdomain.com

# The ntfy topic to publish reminders to
NTFY_TOPIC=showfinder

# Secret key for session signing - change this to a random string
SECRET_KEY=change-me-to-a-random-secret-string

# How many hours before air time to send the default reminder (can be overridden per show)
DEFAULT_REMINDER_HOURS=1

# Internal DNS server IP for resolving local hostnames (e.g. your Pi-hole or router)
DNS_SERVER=192.168.1.1

# Your local timezone — sets the container clock and controls "On Today" date matching
# Find your value at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago
